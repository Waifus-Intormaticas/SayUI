{
  "name": "sayui",
  "version": "1.0.0",
  "description": "A minimal, modular and editorial UI component library built with HTML, SCSS, and compiled CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-waffless/SayUI.git"
  },
  "keywords": [
    "css",
    "scss",
    "ui-library",
    "components",
    "editorial",
    "blog",
    "html"
  ],
  "author": "Jonathan Ventura",
  "style": "dist/css/sayui.css",
  "scripts": {
    "build": "npm run build:css && npm run build:min",
    "build:css": "sass src/styles/main.scss dist/css/sayui.css",
    "watch": "sass src/styles/main.scss dist/css/sayui.css --watch",
    "build:min": "sass src/styles/main.scss dist/css/sayui.min.css --style=compressed"
  }
}
